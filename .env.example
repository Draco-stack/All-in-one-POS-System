# Database Connection String (PostgreSQL)
DATABASE_URL=

# JWT Authentication Secret
JWT_SECRET=

# Hardware Binding & Licensing HMAC Secret Key
LICENSE_SECRET=

# Server Port (Defaults to 3000)
PORT=3000

# ESC/POS Network Thermal Printer Configuration (Optional, defaults to 127.0.0.1:9100)
PRINTER_HOST=127.0.0.1
PRINTER_PORT=9100

# Optional Frontend API Base URL (Dynamic target)
VITE_API_URL=
-e 
# Stripe Configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
