# ==============================================================================
# Tillora Commercial SaaS & POS — Environment Configuration Template
# ==============================================================================

# Database Connection (PostgreSQL with connection pooling)
DATABASE_URL=postgresql://postgres:password@localhost:5432/tillora_db?schema=public

# Security & Cryptographic Secrets
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_in_production
LICENSE_SECRET=replace_with_a_secure_hmac_license_key_in_production

# Server Networking (Railway / Cloud Run)
PORT=3000
NODE_ENV=production

# Canonical Domain & Rebranding Variables (Configurable for custom domains/brands)
APP_NAME=Tillora
APP_URL=https://tillora.com
PUBLIC_URL=https://tillora.com
SUPPORT_EMAIL=support@tillora.com
SUPPORT_PHONE=+1 (800) 555-TILL (8455)
CORS_ORIGIN=https://tillora.com

# Frontend Build-Time Variables (Vite client bundle)
VITE_APP_NAME=Tillora
VITE_APP_URL=https://tillora.com
VITE_SUPPORT_EMAIL=support@tillora.com
VITE_SUPPORT_PHONE=+1 (800) 555-TILL (8455)
VITE_API_URL=

# Stripe Billing & Payment Gateway (Optional for live subscription billing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Hardware Bridge & Local Printing Configuration (Optional)
PRINTER_HOST=127.0.0.1
PRINTER_PORT=9100
